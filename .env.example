# Supabase Configuration
# Replace these values with your actual Supabase Project URL and Anon Key.
# Ensure that these variables are prefixed with EXPO_PUBLIC_ for Expo to load them.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (used by the Voice Entry AI parser)
# Get one at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
