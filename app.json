{
  "expo": {
    "name": "FinAlert",
    "slug": "finalert",
    "scheme": "finalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/FinAlert_app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_light.png",
      "resizeMode": "contain",
      "backgroundColor": "#02C78E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "FinAlert uses speech recognition to turn your voice into transactions.",
        "NSMicrophoneUsageDescription": "FinAlert uses your microphone to capture voice entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/FinAlert_app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adormuntasir.finalert"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FinAlert uses your microphone to capture voice entries.",
          "speechRecognitionPermission": "FinAlert uses speech recognition to turn your voice into transactions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FinAlert uses your camera to scan receipts and add expenses.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FinAlert accesses your photos so you can import a receipt to scan."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "939b0940-115c-417e-87a3-cd979e1c922a"
      }
    },
    "owner": "sabid1234"
  }
}
