{
  "expo": {
    "name": "finalert",
    "slug": "finalert",
    "scheme": "finalert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo_light.png",
      "resizeMode": "contain",
      "backgroundColor": "#02C78E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["android.permission.RECORD_AUDIO"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adormuntasir.finalert"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FinAlert uses your microphone to capture voice entries.",
          "speechRecognitionPermission": "FinAlert uses speech recognition to turn your voice into transactions.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FinAlert uses your camera to scan receipts and add expenses.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FinAlert accesses your photos so you can import a receipt to scan."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1083735b-aafd-4b61-9e1d-0eef6345b2bb"
      }
    }
  }
}